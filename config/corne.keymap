#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/42.h"

#define ___ &trans

#define DEF 0
#define NAV 1
#define NUM 2
#define MED 3
#define FNC 4
#define VDP 5
#define SYM 6

#define QUICK_TAP_MS 175


&sk {  
    release-after-ms = <1500>;  
    quick-release;             
};

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  

#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5 
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2  

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS) \
    ZMK_HOLD_TAP(NAME, \
        flavor = "balanced"; \
        tapping-term-ms = <280>; \
        quick-tap-ms = <QUICK_TAP_MS>; \
        require-prior-idle-ms = <150>; \
        bindings = <HOLD>, <TAP>; \
        hold-trigger-key-positions = <TRIGGER_POS>; \
        hold-trigger-on-release; \
    )


MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS)  
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS)  

#define ZMK_COMBO_8(NAME, TAP, KEYPOS, LAYERS, COMBO_TERM, COMBO_IDLE, HOLD, SIDE) \
    MAKE_HRM(hm_combo_ ## NAME, &kp, TAP, SIDE THUMBS) \
    ZMK_COMBO_6(NAME, &hm_combo_ ## NAME HOLD 0, KEYPOS, LAYERS, COMBO_TERM, COMBO_IDLE)


#include "combos.dtsi"

#define SIMPLE_MORPH(NAME, MOD, BINDING1, BINDING2) \
    ZMK_MOD_MORPH(NAME, \
        mods = <(MOD_L ## MOD|MOD_R ## MOD)>; \
        bindings = <BINDING1>, <BINDING2>; \
)

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <QUICK_TAP_MS>;
};

// No quick-tap: the tap is a sticky mod, so there is nothing to repeat, and it would only
// forbid the layer on a re-press within the window.
ZMK_HOLD_TAP(sticky_shift_mod_layer,
    flavor = "balanced";
    tapping-term-ms = <150>;
    bindings = <&mo>, <&sk>;
)

// tap-preferred, unlike the other thumbs: under balanced a space-then-letter roll
// resolves as a hold and the space vanishes into the layer.
ZMK_HOLD_TAP(space_layer,
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
    quick-tap-ms = <QUICK_TAP_MS>;
    bindings = <&mo>, <&kp>;
)

// Explicit on/off rather than &kt flip: each tri-state fires its own start binding, so
// pressing swapper_shift while swapper already holds Alt would flip Alt off.
/ {
    behaviors {
        kt_on: kt_on {
            compatible = "zmk,behavior-key-toggle";
            #binding-cells = <1>;
            toggle-mode = "on";
        };
        kt_off: kt_off {
            compatible = "zmk,behavior-key-toggle";
            #binding-cells = <1>;
            toggle-mode = "off";
        };
    };
};

ZMK_TRI_STATE(swapper,
    bindings = <&kt_on LALT>, <&kp TAB>, <&kt_off LALT>;
    ignored-key-positions = <LT3 LT1>;
)

ZMK_TRI_STATE(swapper_shift,
    bindings = <&kt_on LALT>, <&kp LS(TAB)>, <&kt_off LALT>;
    ignored-key-positions = <LT3 LT1>;
)

ZMK_BEHAVIOR(move_and_switch_to_desktop, macro,
    bindings = <&kp LG(LC(F1)) &kp LC(F1)>;
)


SIMPLE_MORPH(lpar_lt, SFT, &kp LPAR, &kp LT)
SIMPLE_MORPH(rpar_gt, SFT, &kp RPAR, &kp GT)
SIMPLE_MORPH(shift_brace_lt, SFT, &kp LPAR, &kp LEFT_BRACE)

// PLUS is LS(EQUAL), so Ctrl+plus reaches the host as Ctrl+Shift+Equal and apps that
// bind only Ctrl+= for zoom miss it. Under Ctrl send the bare EQUAL instead. keep-mods
// stops the morph masking the modifier that triggered it, so Ctrl still arrives. The Mac
// swaps Ctrl and Cmd for this keyboard, so the same branch covers Cmd+= there.
ZMK_MOD_MORPH(plus_eq,
    mods = <(MOD_LCTL|MOD_RCTL)>;
    keep-mods = <(MOD_LCTL|MOD_RCTL)>;
    bindings = <&kp PLUS>, <&kp EQUAL>;
)

#define desk_left &kp LG(LC(LEFT))
#define desk_right &kp LG(LC(RIGHT))

// Absolute monitor targets, not a toggle: both hosts bind both hotkeys to the same
// input, so the active host always drives the monitor to the named machine.
// arch = DisplayPort-1 (0x0f), mac = HDMI-1 (0x11).
// Meta+Ctrl+Alt, no shift: KDE matches the modifier set exactly, so the mac side
// binds these three too rather than its own four-modifier hyper.
#define SUPER(key) LC(LA(LG(key)))
#define DISP_ARCH SUPER(N1)
#define DISP_MAC  SUPER(N2)

// Hotkey first (the host we're leaving still owns the BT link), then hand over.
#define MAKE_HOST_SWITCH(NAME, DISP, PROFILE) \
    ZMK_BEHAVIOR(NAME, macro, \
        wait-ms = <40>; \
        tap-ms = <40>; \
        bindings = <&kp DISP>, <&bt BT_SEL PROFILE>; \
    )

MAKE_HOST_SWITCH(sw_arch, DISP_ARCH, 0)
MAKE_HOST_SWITCH(sw_mac,  DISP_MAC,  1)

ZMK_LAYER(default_layer,
//  ╭─────────────────┬─────────────────┬─────────────────┬─────────────────┬─────────────────┬─────────────────╮   ╭─────────────────┬─────────────────┬─────────────────┬─────────────────┬─────────────────┬─────────────────╮
    &kp TAB           &kp Q             &kp W             &kp E             &kp R             &kp T                 &kp Y             &kp U             &kp I             &kp O             &kp P             &kp BACKSPACE    
//  ├─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┤   ├─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┤
    &kp ESCAPE        &hml LEFT_GUI A   &hml LEFT_ALT S   &hml LCTRL D      &hml LEFT_SHIFT F &kp G                 &kp H             &hmr RIGHT_SHIFT J &hmr RIGHT_CONTROL K &hmr LEFT_ALT L &hmr RIGHT_GUI SEMICOLON &kp SINGLE_QUOTE
//  ├─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┤   ├─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┤
    &kp LEFT_SHIFT    &kp Z             &kp X             &kp C             &kp V             &kp B                 &kp N             &kp M             &kp COMMA         &kp DOT           &kp FSLH          &kp RIGHT_SHIFT  
//  ╰─────────────────┴─────────────────┴─────────────────┼─────────────────┼─────────────────┼─────────────────┤   ├─────────────────┼─────────────────┼─────────────────┼─────────────────┴─────────────────┴─────────────────╯
                                        &mo MED           &lt NAV BACKSPACE &space_layer VDP SPACE    &lt SYM ENTER &sticky_shift_mod_layer NUM RIGHT_SHIFT &lt FNC ESCAPE
//                                      ╰─────────────────┴─────────────────┴─────────────────╯   ╰─────────────────┴─────────────────┴─────────────────╯
)


ZMK_LAYER(nav_layer,
//  ╭─────────────────┬─────────────────┬─────────────────┬─────────────────┬─────────────────┬─────────────────╮   ╭─────────────────┬─────────────────┬─────────────────┬─────────────────┬─────────────────┬─────────────────╮
    &none             &none             &swapper          &none             &swapper_shift    &none                 &kp LC(LS(Z))     &kp LC(V)         &kp LC(C)         &kp LC(X)         &kp LC(Z)         &none
//  ├─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┤   ├─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┤
    &none             &kp LEFT_GUI      &kp LEFT_ALT      &kp RIGHT_CONTROL &kp RIGHT_SHIFT   &none                 &kp LEFT_ARROW    &kp DOWN_ARROW    &kp UP_ARROW      &kp RIGHT         &none             &none            
//  ├─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┤   ├─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┤
    &none             &none             desk_left         &none             desk_right        &none                 &kp HOME          &kp PAGE_DOWN     &kp PAGE_UP       &kp END           &kp INSERT        &kp SCROLLLOCK
//  ╰─────────────────┴─────────────────┴─────────────────┼─────────────────┼─────────────────┼─────────────────┤   ├─────────────────┼─────────────────┼─────────────────┼─────────────────┴─────────────────┴─────────────────╯
                                                          ___               ___               ___                   &kp ENTER         &kp DELETE     &kp BACKSPACE       
//                                      ╰─────────────────┴─────────────────┴─────────────────╯   ╰─────────────────┴─────────────────┴─────────────────╯
)

ZMK_LAYER(num_layer,
//  ╭─────────────────┬─────────────────┬─────────────────┬─────────────────┬─────────────────┬─────────────────╮   ╭─────────────────┬─────────────────┬─────────────────┬─────────────────┬─────────────────┬─────────────────╮
    ___               &none             &kp NUMBER_7      &kp NUMBER_8      &kp NUMBER_9      &none                 &none             &none             &none             &none             &none             &kp BACKSPACE
//  ├─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┤   ├─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┤
    &none             &kp NUMBER_0      &kp NUMBER_4      &kp NUMBER_5      &kp NUMBER_6      &none                 &none             &kp LEFT_SHIFT    &kp LEFT_CONTROL  &kp LEFT_ALT      &kp LEFT_GUI      &none            
