// Declared last so it lands on layer 6. ZMK_LAYER assigns indices in declaration order.
ZMK_LAYER(symbol_layer,
//  ╭─────────────────┬─────────────────┬─────────────────┬─────────────────┬─────────────────┬─────────────────╮   ╭─────────────────┬─────────────────┬─────────────────┬─────────────────┬─────────────────┬─────────────────╮
    &kp DOT           &kp EQUAL         &kp AMPERSAND     &kp STAR          &kp BSLH          &kp PIPE              &none             &kp LBKT          &kp RBKT          &kp RPAR          &kp RBRC          &kp BACKSPACE
//  ├─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┤   ├─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┤
    &kp SEMICOLON     &kp COLON         &kp DOLLAR        &kp PERCENT       &kp CARET         &plus_eq              &none             &kp LSHFT         &kp LCTRL         &kp LEFT_ALT      &kp LEFT_GUI      &none
//  ├─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┤   ├─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┼─────────────────┤
    &kp GRAVE         &kp TILDE         &kp EXCLAMATION   &kp AT            &kp HASH          &kp MINUS             &none             &none             &kp LESS_THAN     &kp GREATER_THAN  &none             &none
//  ╰─────────────────┴─────────────────┴─────────────────┼─────────────────┼─────────────────┼─────────────────┤   ├─────────────────┼─────────────────┼─────────────────┼─────────────────┴─────────────────┴─────────────────╯
                                                          &shift_brace_lt   &kp UNDER         &kp SPACE             &none             &none             &none
//                                      ╰─────────────────┴─────────────────┴─────────────────╯   ╰─────────────────┴─────────────────┴─────────────────╯
)
